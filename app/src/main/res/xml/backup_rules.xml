<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower (API 26-30) cannot tell cloud backup from device transfer, so nothing
    is backed up automatically there; users export a backup file themselves (Cài đặt).
    See docs/SECURITY.md.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
