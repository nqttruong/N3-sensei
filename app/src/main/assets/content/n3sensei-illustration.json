      "grammar": [
        {
          "id": "illus-l01-g1",
          "pattern": "〜たばかり",
          "structure": "V-た + ばかり",
          "meaningVi": "vừa mới (làm gì)",
          "usage": "Diễn tả một hành động vừa xảy ra chưa lâu theo cảm nhận của người nói; khoảng thời gian thực tế có thể là vài phút hoặc vài tháng.",
          "cautionNote": "Khác 〜たところ: 〜たところ chỉ đúng thời điểm ngay sau khi hành động kết thúc, còn 〜たばかり nhấn mạnh cảm giác “chưa được bao lâu”.",
          "examples": [
            "illus-ex31",
            "illus-ex32"
          ],
          "exercises": [
            {
              "id": "illus-l01-g1-q1",
              "prompt": "{日本|にほん}に＿＿＿ばかりです。",
              "options": [
                "{来|く}る",
                "{来|き}た",
                "{来|き}て",
                "{来|こ}ない"
              ],
              "answerIndex": 1,
              "explanationVi": "〜ばかり (vừa mới) đi với thể た của động từ: 来た + ばかり."
            }
          ]
        },
        {
          "id": "illus-l01-g2",
          "pattern": "〜ようにする",
          "structure": "V-る / V-ない + ようにする",
          "meaningVi": "cố gắng (tạo thói quen) làm / không làm gì",
          "usage": "Diễn tả nỗ lực có ý thức để duy trì một hành động hoặc thói quen; thường dùng ở dạng 〜ようにしている.",
          "cautionNote": "Khác 〜ようになる: 〜ようになる diễn tả sự thay đổi (trở nên có thể / bắt đầu làm), không phải nỗ lực của bản thân.",
          "examples": [
            "illus-ex33",
            "illus-ex34"
          ],
          "exercises": [
            {
              "id": "illus-l01-g2-q1",
              "prompt": "{毎日|まいにち}{運動|うんどう}＿＿＿ようにしています。",
              "options": [
                "する",
                "した",
                "して",
                "しよう"
              ],
              "answerIndex": 0,
              "explanationVi": "ようにする đi với thể từ điển (る) hoặc thể ない: 運動する + ようにしています."
            }
          ]
        },
        {
