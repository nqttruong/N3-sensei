<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Study reminders (runtime permission on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Added by WorkManager but not needed: reminders use no network constraint and no
        foreground service. RECEIVE_BOOT_COMPLETED and WAKE_LOCK stay (rescheduling after a
        reboot, running the job). The app has no INTERNET permission at all.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".N3SenseiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.N3Sensei">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.N3Sensei">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Cần học lại" action on a reminder; only reachable through our own PendingIntent. -->
        <receiver
            android:name=".app.reminder.ReminderActionReceiver"
            android:exported="false" />

        <!-- Widgets: 2×2 (first name kept for widgets already placed) and 1×1. Exported as
             launchers bind them; they only render, and act through our own PendingIntents. -->
        <receiver
            android:name=".app.widget.SmallStudyWordWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_small_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/study_word_widget_small_info" />
        </receiver>

        <receiver
            android:name=".app.widget.StudyWordWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/study_word_widget_info" />
        </receiver>
    </application>

</manifest>
