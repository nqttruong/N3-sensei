<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Study reminders (runtime permission on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        "Dịch nhanh" (ML Kit on-device translation): the network is used only to download a
        language model from Google when the learner asks for it; translation itself runs on the
        device. ACCESS_NETWORK_STATE tells "offline" apart from a failed download. Both are
        also declared by ML Kit itself.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        "Dịch nhanh" popup: a small floating window over the app where the text was selected
        ("Hiển thị trên ứng dụng khác"), granted by the learner in system settings before the first
        popup. Used for that popup only; no service, no screen reading.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Added by WorkManager but not needed: reminders use no foreground service.
        RECEIVE_BOOT_COMPLETED and WAKE_LOCK stay (rescheduling after a reboot, running the job).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- "Dịch nhanh" pronunciation: reach the device's speech engine (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".N3SenseiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.N3Sensei">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.N3Sensei">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            "Dịch nhanh" in other apps' text selection menu (ACTION_PROCESS_TEXT, text/plain).
            Exported so the system can open it from any app; it hands the text to the floating
            popup and finishes at once (or first asks for the overlay permission). It returns
            nothing. Empty taskAffinity and excludeFromRecents: it never joins N3 Sensei's task
            or the recent apps.
        -->
        <activity
            android:name=".app.translate.QuickTranslateActivity"
            android:exported="true"
            android:label="@string/quick_translate_action"
            android:theme="@style/Theme.N3Sensei.QuickTranslate"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Cần học lại" action on a reminder; only reachable through our own PendingIntent. -->
        <receiver
            android:name=".app.reminder.ReminderActionReceiver"
            android:exported="false" />

        <!-- Widgets: 2×2 (first name kept for widgets already placed) and 1×1. Exported as
             launchers bind them; they only render, and act through our own PendingIntents. -->
        <receiver
            android:name=".app.widget.SmallStudyWordWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_small_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/study_word_widget_small_info" />
        </receiver>

        <receiver
            android:name=".app.widget.StudyWordWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/study_word_widget_info" />
        </receiver>
    </application>

</manifest>
