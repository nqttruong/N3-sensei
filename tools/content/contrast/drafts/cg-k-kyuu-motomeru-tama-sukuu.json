  "theory": [
    {
      "id": "ct-k-kyuu-motomeru-tama-sukuu-1",
      "titleVi": "Phần thêm vào quyết định nghĩa",
      "bodyVi": "Cùng phần 求 cho âm キュウ. Có 王 bên trái → 球 (vật tròn: bóng, cầu). Có 攵 bên phải → 救 (hành động cứu). Chỉ 求 → mong cầu, yêu cầu."
    },
    {
      "id": "ct-k-kyuu-motomeru-tama-sukuu-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "求: 求める (yêu cầu), 要求, 求人 (tuyển người). 球: 野球 (bóng chày), 地球 (trái đất), 電球 (bóng đèn). 救: 救う (cứu), 救急車 (xe cứu thương), 救助 (cứu hộ)."
    }
  ],
