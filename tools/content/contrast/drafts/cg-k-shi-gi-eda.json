  "theory": [
    {
      "id": "ct-k-shi-gi-eda-1",
      "titleVi": "Bộ bên trái",
      "bodyVi": "Không có bộ: 支 (chống đỡ, chi tiền, chi nhánh). 扌 (tay) → 技 (kỹ năng khéo tay). 木 (cây) → 枝 (cành cây). 支 và 枝 cùng âm シ; 技 đọc ギ."
    },
    {
      "id": "ct-k-shi-gi-eda-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "支: 支える (nâng đỡ), 支出 (chi tiêu), 支店 (chi nhánh), 支払う (thanh toán). 技: 技術 (kỹ thuật), 演技 (diễn xuất), 競技 (môn thi đấu). 枝: 枝 (cành), 枝豆 (đậu nành non)."
    }
  ],
