  "theory": [
    {
      "id": "ct-k-han-hen-saka-ita-1",
      "titleVi": "Bộ thủ quyết định",
      "bodyVi": "Không có bộ: 反 (ngược, phản). 辶 (đi) → 返 (đi ngược lại: trả). 土 (đất) → 坂 (dốc). 木 (gỗ) → 板 (ván, bảng)."
    },
    {
      "id": "ct-k-han-hen-saka-ita-2",
      "titleVi": "Âm đọc",
      "bodyVi": "反: ハン (反対); 返: ヘン, かえ.す (返事); 坂: さか, ハン; 板: いた, ハン／バン (黒板 こくばん). Ba chữ đọc ハン nên khi viết từ Hán phải nhớ nghĩa."
    }
  ],
