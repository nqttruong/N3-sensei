  "theory": [
    {
      "id": "ct-v-kowareru-wareru-oreru-yabureru-1",
      "titleVi": "Nhìn vào vật bị hỏng",
      "bodyVi": "Máy móc, đồ có cơ chế (時計、パソコン、エアコン) → 壊れる. Vật cứng, giòn (皿、コップ、ガラス、卵) → 割れる. Vật dài, mảnh (枝、骨、箸、傘の骨) → 折れる. Vật mỏng, mềm (紙、服、袋、障子) → 破れる."
    },
    {
      "id": "ct-v-kowareru-wareru-oreru-yabureru-2",
      "titleVi": "Tha động từ",
      "bodyVi": "壊れる ↔ 壊す, 割れる ↔ 割る, 折れる ↔ 折る, 破れる ↔ 破る. Quy tắc chọn từ giống hệt cặp tự động từ."
    }
  ],
