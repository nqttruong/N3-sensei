  "theory": [
    {
      "id": "ct-k-bou-nai-wasureru-nozomu-1",
      "titleVi": "Nhìn phần thêm vào",
      "bodyVi": "亡 một mình: chết, mất (亡くなる: qua đời – cách nói lịch sự). 心 ở dưới → 忘 (quên). 月 và 王 → 望 (hy vọng, ngóng trông). Ba chữ đều có âm ボウ: 死亡 (しぼう), 忘年会 (ぼうねんかい), 希望 (きぼう)."
    },
    {
      "id": "ct-k-bou-nai-wasureru-nozomu-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "亡: 亡くなる (qua đời), 死亡 (tử vong). 忘: 忘れる (quên), 忘れ物 (đồ để quên), 忘年会 (tiệc tất niên). 望: 希望 (hy vọng), 望む (mong muốn), 失望 (thất vọng)."
    }
  ],
