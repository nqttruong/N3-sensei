  "theory": [
    {
      "id": "ct-k-mi-matsu-1",
      "titleVi": "Phân biệt bằng nét ngang",
      "bodyVi": "Cả hai dựa trên 木 (cây) thêm một nét ngang. Nét trên ngắn hơn (未): cây chưa lớn, 'chưa'. Nét trên dài hơn (末): đánh dấu ở ngọn, 'cuối'. Khi viết tay phải giữ đúng tỉ lệ."
    },
    {
      "id": "ct-k-mi-matsu-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "未: 未来 (tương lai: thời gian chưa đến), 未満 (chưa đủ), 未定 (chưa định), 未成年. 末: 週末 (cuối tuần), 年末 (cuối năm), 月末, 期末, 末っ子 (con út)."
    }
  ],
