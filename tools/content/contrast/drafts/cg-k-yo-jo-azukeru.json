  "theory": [
    {
      "id": "ct-k-yo-jo-azukeru-1",
      "titleVi": "Phần thêm vào",
      "bodyVi": "予 (trước) là gốc. 广 (mái nhà) bao lấy → 序 (thứ tự). 頁 bên phải → 預 (gửi). 予 và 預 cùng âm ヨ, dễ nhầm trong 予金 (sai) ／ 預金 (đúng)."
    },
    {
      "id": "ct-k-yo-jo-azukeru-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "予: 予定 (dự định), 予約 (đặt trước), 予報 (dự báo), 予習 (học trước). 序: 順序 (thứ tự), 序章 (chương mở đầu). 預: 預ける (gửi), 預かる (giữ hộ), 預金 (tiền gửi)."
    }
  ],
