  "theory": [
    {
      "id": "ct-k-koori-eien-oyogu-1",
      "titleVi": "Nhìn chấm và bộ nước",
      "bodyVi": "永: có chấm ở đỉnh, không có chấm bên trái. 氷: giống 水 thêm một chấm nhỏ bên trái (giọt nước đóng băng). 泳: bộ 氵 bên trái + 永."
    },
    {
      "id": "ct-k-koori-eien-oyogu-2",
      "titleVi": "Âm đọc",
      "bodyVi": "氷: こおり, ヒョウ (氷山). 永: なが.い, エイ (永遠). 泳: およ.ぐ, エイ (水泳). 永 và 泳 cùng âm エイ nên dễ nhầm trong 水泳 ／ 永遠."
    }
  ],
