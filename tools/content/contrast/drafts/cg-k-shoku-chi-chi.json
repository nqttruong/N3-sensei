  "theory": [
    {
      "id": "ct-k-shoku-chi-chi-1",
      "titleVi": "Bộ thủ là chìa khóa",
      "bodyVi": "Phần 直 chung, nhìn phần còn lại: 木 bên trái → liên quan cây cối (植); 亻 bên trái → liên quan con người, giá trị (値); 罒 ở trên → đặt, để (置)."
    },
    {
      "id": "ct-k-shoku-chi-chi-2",
      "titleVi": "Âm đọc",
      "bodyVi": "植: ショク, う.える (植物, 植える). 値: チ, ね, あたい (価値, 値段). 置: チ, お.く (位置, 置く). 値 và 置 cùng âm チ nên dễ viết nhầm trong 価値 ／ 位置."
    }
  ],
