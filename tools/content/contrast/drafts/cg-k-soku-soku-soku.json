  "theory": [
    {
      "id": "ct-k-soku-soku-soku-1",
      "titleVi": "Bộ bên trái",
      "bodyVi": "Không có bộ: 則 (quy tắc). 亻 (người) → 側 (phía bên). 氵 (nước) → 測 (đo lường). Ba chữ đọc ソク giống nhau nên phải nhớ nghĩa của từ ghép."
    },
    {
      "id": "ct-k-soku-soku-soku-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "則: 規則 (quy tắc), 原則 (nguyên tắc). 側: 右側 (bên phải), 内側 (bên trong), 側面 (mặt bên). 測: 測る (đo), 予測 (dự đoán), 測定 (đo đạc)."
    }
  ],
