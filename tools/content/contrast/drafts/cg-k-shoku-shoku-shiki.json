  "theory": [
    {
      "id": "ct-k-shoku-shoku-shiki-1",
      "titleVi": "Chỉ nhìn bộ trái",
      "bodyVi": "Phần phải giống hệt nhau, nên bộ trái là tất cả: 耳 (tai) → 職; 糸 (sợi) → 織; 言 (lời nói) → 識. 職, 織 đọc ショク; 識, 織 đọc シキ (組織 そしき)."
    },
    {
      "id": "ct-k-shoku-shoku-shiki-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "職: 職業 (nghề nghiệp), 就職 (tìm được việc), 職場 (nơi làm việc). 織: 組織 (tổ chức), 織る (dệt). 識: 知識 (kiến thức), 常識 (lẽ thường), 意識 (ý thức)."
    }
  ],
