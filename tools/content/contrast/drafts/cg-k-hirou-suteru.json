  "theory": [
    {
      "id": "ct-k-hirou-suteru-1",
      "titleVi": "Nhìn phần bên phải",
      "bodyVi": "拾: bên phải là 合 (nắp đậy lên miệng hộp: gom vào) → nhặt. 捨: bên phải là 舎 (căn nhà: bỏ lại sau lưng) → vứt. 舎 có nhiều nét hơn, có hình mái nhà và chữ 土."
    },
    {
      "id": "ct-k-hirou-suteru-2",
      "titleVi": "Cách đọc",
      "bodyVi": "拾: ひろ.う, シュウ (拾得物: đồ nhặt được); cũng là chữ 'mười' trên chứng từ. 捨: す.てる, シャ (取捨選択: chọn lọc)."
    }
  ],
