  "theory": [
    {
      "id": "ct-k-kyo-kyo-kyo-1",
      "titleVi": "Bộ bên trái",
      "bodyVi": "Không có bộ: 巨 (to lớn). 扌 (tay) → 拒 (đẩy ra, từ chối). ⻊ (chân) → 距 (khoảng cách). Âm giống nhau hoàn toàn nên chỉ có thể dựa vào nghĩa của từ."
    },
    {
      "id": "ct-k-kyo-kyo-kyo-2",
      "titleVi": "Từ hay gặp",
      "bodyVi": "巨: 巨大 (khổng lồ), 巨人 (người khổng lồ), 巨額 (số tiền khổng lồ). 拒: 拒否 (từ chối), 拒絶 (cự tuyệt), 拒む. 距: 距離 (khoảng cách), 長距離 (đường dài)."
    }
  ],
