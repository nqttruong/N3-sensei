  "theory": [
    {
      "id": "ct-k-kou-shin-1",
      "titleVi": "Đếm nét ngang trên cùng",
      "bodyVi": "幸: trên cùng là 土 (hai nét ngang, nét dưới dài hơn). 辛: trên cùng là 立 (chấm và nét ngang). Người ta hay nói 'cay đắng (辛) thêm một nét là hạnh phúc (幸)'."
    },
    {
      "id": "ct-k-kou-shin-2",
      "titleVi": "Cách đọc của 辛い",
      "bodyVi": "辛い có hai cách đọc: からい (cay) và つらい (khổ sở). Ngữ cảnh món ăn → からい; ngữ cảnh cảm xúc, công việc → つらい. 幸 đọc しあわ.せ, さいわ.い, コウ."
    }
  ],
